PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:5000
DIGITALBOT_API_URL=http://localhost:4002
# Production: https://digital-api-46ss.onrender.com (origin only; do not add /api)
# Use a public HTTPS tunnel to local port 4003 for local testing with hosted voice workers.
DIGITALBOT_WEBHOOK_BASE_URL=https://YOUR-NGROK-HOST.ngrok-free.app
# Production default: https://mcp-server-61zc.onrender.com (origin only; do not add /api)
ALLOWED_ORIGINS=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/ai-voice-platform
# Optional shared cache for safe dashboard reads. Leave REDIS_URL empty to disable it.
# Use rediss:// in production when your Redis provider supports TLS.
REDIS_URL=
REDIS_KEY_PREFIX=ai-voice-platform
# Kept at or below the dashboard browser cache TTL (maximum accepted value: 15).
DASHBOARD_CACHE_TTL_SECONDS=10
# Redis is an optional accelerator. Fail fast and use MongoDB during an outage.
REDIS_COMMAND_TIMEOUT_MS=250
REDIS_FAILURE_BACKOFF_MS=5000
JWT_SECRET=replace-with-a-long-random-secret
INTEGRATION_ENCRYPTION_KEY=replace-with-a-long-random-secret
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=voice-platform-agent
# Keep warm worker processes ready so new calls avoid process startup latency.
LIVEKIT_AGENT_IDLE_PROCESSES=2
LIVEKIT_AGENT_INITIALIZE_TIMEOUT_MS=60000
LIVEKIT_AGENT_SHUTDOWN_TIMEOUT_MS=60000
LIVEKIT_SIP_INBOUND_TRUNK_ID=
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
LIVEKIT_SIP_URI=

# Call recordings are saved in your AWS S3 bucket.
AWS_RECORDING_S3_BUCKET=
AWS_RECORDING_S3_REGION=
AWS_RECORDING_S3_ACCESS_KEY_ID=
AWS_RECORDING_S3_SECRET_ACCESS_KEY=
AWS_RECORDING_S3_PREFIX=recordings
# Optional. Leave empty for private buckets; dashboard playback will use the authenticated backend route.
AWS_RECORDING_S3_PUBLIC_BASE_URL=
# Optional. Use only for S3-compatible providers such as MinIO/R2.
AWS_RECORDING_S3_ENDPOINT=
AWS_RECORDING_S3_FORCE_PATH_STYLE=false
# Expiring URLs let external audio providers fetch private recordings without an API key.
# The signing secret falls back to JWT_SECRET when left empty.
RECORDING_URL_SIGNING_SECRET=
RECORDING_URL_TTL_SECONDS=5184000

# Legacy local fallback for old web recordings when S3 is not configured.
WEB_RECORDING_STORAGE_DIR=recordings
OPENAI_API_KEY=
# Knowledge-base RAG supports Google or OpenAI embeddings. Google is selected automatically when GOOGLE_API_KEY is set.
OPENAI_BASE_URL=https://api.openai.com/v1
KNOWLEDGE_EMBEDDING_PROVIDER=google
KNOWLEDGE_EMBEDDING_MODEL=gemini-embedding-001
KNOWLEDGE_EMBEDDING_DIMENSIONS=1536
KNOWLEDGE_EMBEDDING_BATCH_SIZE=64
KNOWLEDGE_EMBEDDING_TIMEOUT_MS=30000
# MongoDB Atlas Vector Search index name. The backend falls back to cosine search when this index is unavailable.
KNOWLEDGE_VECTOR_INDEX=knowledge_chunks_vector
KNOWLEDGE_TOP_K=5
KNOWLEDGE_MINIMUM_SCORE=0.28
KNOWLEDGE_MAX_CONTEXT_CHARACTERS=9000
GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the redirect URI configured in Google Cloud Console.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/integrations/google/callback
SARVAM_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
VOBIZ_BASE_URL=https://api.vobiz.ai/api
VOBIZ_INBOUND_TRUNK_ID=
# Display names applied automatically when Vozon configures Vobiz SIP trunks.
VOBIZ_INBOUND_TRUNK_NAME=Vozon Inbound
VOBIZ_OUTBOUND_TRUNK_NAME=Vozon Outbound
# Exotel Voicebot Applet. EXOTEL_PUBLIC_BASE_URL must be the public HTTPS
# origin of this backend (no trailing slash). Paste the resolver URL
# https://your-backend.example.com/api/exotel/voicebot into Exotel.
EXOTEL_PUBLIC_BASE_URL=https://your-backend.example.com
EXOTEL_RESOLVER_PATH=/api/exotel/voicebot
EXOTEL_STREAM_PATH=/api/exotel/voicebot/stream
# Use a long random secret. The HTTPS resolver uses it to sign a compact,
# short-lived WSS query token; the permanent secret is never returned.
EXOTEL_STREAM_SECRET=
# Basic auth is an alternative to EXOTEL_STREAM_SECRET.
EXOTEL_STREAM_USERNAME=
EXOTEL_STREAM_PASSWORD=
EXOTEL_STREAM_MAX_CONNECTIONS=100
# One absolute deadline for phone-provider verification/import requests.
TELEPHONY_PROVIDER_TIMEOUT_MS=12000
# Debounce terminal events so the final transcript and provider usage settle
# before billing/webhooks. Active recording egress is awaited up to the bound.
CALL_FINALIZATION_SETTLE_MS=10000
CALL_RECORDING_FINALIZATION_WAIT_MS=600000
CALL_RUNTIME_FINALIZATION_WAIT_MS=60000
CALL_FINALIZATION_CONCURRENCY=4
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Enterprise plan is created automatically at $500 USD/month.
RAZORPAY_ENTERPRISE_MONTHLY_USD=500
# Resend transactional email. Keep the real key only in .env or your deployment secret manager.
RESEND_API_KEY=
EMAIL_FROM=
SUPPORT_INBOX=hello@vozon.ai
CONTACT_EMAIL=hello@vozon.ai
EMAIL_USER=
EMAIL_PASS=Vozon <noreply@your-verified-domain.com>
REQUIRE_EMAIL_VERIFICATION=false
ENABLE_POST_CALL_AI_ANALYSIS=false
# Telephony is not billed for now (set to 0). Set to your real carrier per-minute rate to include it.
COST_TELEPHONY_PER_MINUTE=0
COST_INR_PER_USD=96.5
# Vozon platform fee, prorated by call duration. Total = provider cost + (seconds / 60 * this).
PLATFORM_FEE_INR_PER_MINUTE=1.5
# Optional exact model prices. Keys are "provider:model"; wildcard/generic model pricing is intentionally not supported.
# MODEL_PRICING_OVERRIDES_JSON={"llm":{"sarvam:sarvam-30b":{"inputPerMillionTokens":0,"outputPerMillionTokens":0}},"stt":{"elevenlabs:scribe_v2_realtime":{"perMinute":0}},"tts":{"elevenlabs:eleven_flash_v2_5":{"perMillionCharacters":0,"voiceMultipliers":{"VOICE_ID":1}}}}
INITIAL_CREDITS=5
MINIMUM_CALL_START_CREDITS=0.05
BILLING_MARKUP_MULTIPLIER=1

