{
  "name": "ai-voice-platform-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "postinstall": "node scripts/patchLivekitGooglePlugin.mjs && node scripts/patchLivekitOpenAIPlugin.mjs && node scripts/patchLivekitSarvamPlugin.mjs",
    "agent:dev": "tsx src/agent.ts dev",
    "build": "tsc",
    "start": "node dist/server.js",
    "agent:start": "node dist/agent.js start",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:pricing": "tsx scripts/modelPricingSmoke.ts",
    "test:razorpay": "tsx scripts/razorpayBillingSmoke.ts",
    "test:billing-adjustments": "tsx scripts/billingAdjustmentSmoke.ts",
    "test:agent-errors": "tsx scripts/agentErrorPolicySmoke.ts",
    "test:livekit-webhook-policy": "tsx scripts/livekitWebhookPolicySmoke.ts",
    "test:call-duration-policy": "tsx scripts/callDurationPolicySmoke.ts",
    "test:language-switching": "tsx scripts/languageSwitchingSmoke.ts",
    "test:sarvam-tts": "tsx scripts/sarvamTtsTextSmoke.ts",
    "test:sarvam-stream": "node scripts/sarvamStreamingSmoke.mjs",
    "test:gemini-cache": "node scripts/geminiContextCacheSmoke.mjs",
    "test:openai-llm-cache": "node scripts/openAiLlmCacheSmoke.mjs",
    "test:openai-tts-stream": "node scripts/openAiTtsStreamingSmoke.mjs",
    "test:sarvam-llm-latency": "node scripts/sarvamLlmLatencySmoke.mjs",
    "audit:billing": "tsx scripts/billingAccuracyAudit.ts",
    "smoke:phase1": "tsx scripts/phase1Smoke.ts",
    "smoke:phase2": "tsx scripts/phase2Smoke.ts",
    "smoke:phase3": "tsx scripts/phase3Smoke.ts",
    "smoke:phase4": "tsx scripts/phase4Smoke.ts",
    "smoke:phase6": "tsx scripts/phase6Smoke.ts",
    "smoke:phase7": "tsx scripts/phase7Smoke.ts",
    "smoke:phase8": "tsx scripts/phase8Smoke.ts",
    "smoke:phase9": "tsx scripts/phase9Smoke.ts",
    "smoke:phase10": "tsx scripts/phase10Smoke.ts",
    "smoke:phase11": "tsx scripts/phase11Smoke.ts",
    "smoke:phase12": "tsx scripts/phase12Smoke.ts",
    "smoke:campaign": "tsx scripts/campaignSmoke.ts",
    "test:exotel-bridge": "tsx scripts/exotelBridgeSmoke.ts",
    "test:exotel-handshake": "tsx scripts/exotelHandshakeSmoke.ts",
    "smoke:knowledge": "tsx scripts/knowledgeSmoke.ts",
    "setup:dashboard-indexes": "node dist/scripts/setupDashboardIndexes.js",
    "migrate:phone-number-uniqueness": "node dist/scripts/migratePhoneNumberUniqueness.js",
    "migrate:inbound-route-metadata": "node dist/scripts/migrateInboundRouteMetadata.js",
    "repair:outbound-setups": "node dist/scripts/recoverOutboundSetups.js",
    "repair:billing-webhook-finalization": "tsx scripts/repairBillingWebhookFinalization.ts",
    "setup:knowledge-index": "tsx scripts/setupKnowledgeVectorIndex.ts"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@livekit/agents": "^1.5.0",
    "@livekit/agents-plugin-deepgram": "^1.5.0",
    "@livekit/agents-plugin-elevenlabs": "^1.5.0",
    "@livekit/agents-plugin-google": "1.5.0",
    "@livekit/agents-plugin-openai": "1.5.0",
    "@livekit/agents-plugin-sarvam": "1.5.0",
    "@livekit/protocol": "^1.46.6",
    "@livekit/rtc-node": "^0.13.31",
    "@types/multer": "^2.0.0",
    "@types/pdf-parse": "^1.1.5",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^10.7.0",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.15.4",
    "mammoth": "^1.11.0",
    "mongoose": "^8.9.5",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pdf-parse": "^1.1.1",
    "redis": "^6.1.0",
    "ws": "^8.21.0"
  },
  "optionalDependencies": {
    "@livekit/rtc-ffi-bindings-linux-x64-gnu": "0.12.60"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.1",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
